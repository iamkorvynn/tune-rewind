# TuneRewind — Spotify (optional). Leave unset to run on bundled sample data.
# Never commit a real key. Copy this file to .env and fill it in locally.
# Option A: a user access token (from Spotify's Authorization Code flow)
VITE_SPOTIFY_ACCESS_TOKEN=
# Option B: app credentials (client-credentials flow, top artists/tracks only)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Node script (scripts/fetch-spotify.mjs) reads SPOTIFY_CLIENT_ID / SPOTIFY_CLIENT_SECRET
# or SPOTIFY_ACCESS_TOKEN from the environment / .env file.
